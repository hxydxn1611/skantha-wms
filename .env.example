# WARLOG configuration. Copy to .env (git-ignored) and fill in.
# The app refuses to start without FLASK_SECRET_KEY.

# Session signing key: generate with  py -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Outgoing mail for signup OTP codes and vendor invoices.
# Use an app password for a dedicated sender account. Leave empty to disable email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# RBAC rollout switch: off | audit | enforce  (see webapp/rbac_config.py)
RBAC_MODE=off

# Optional: run against a different database file (tests/tooling)
# WARLOG_DB_PATH=

# Public address used in invitation and password-reset links (RBAC Phase 4).
# Set it in production so a forged Host header can never change the link.
# APP_BASE_URL=https://warlog.example.com/
